{
  "name": "narrative-launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "dashboard"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "npm run build:bot && npm run build:dashboard",
    "build:bot": "tsc && node scripts/copy-assets.mjs",
    "build:dashboard": "npm --workspace=dashboard run build",
    "start": "node dist/index.js",
    "lint": "npm --workspace=dashboard run lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@solana/web3.js": "^3.1.1",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "node-telegram-bot-api": "^2.1.0",
    "openai": "^4.85.4",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/node-telegram-bot-api": "^0.64.15",
    "msw": "^2.7.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
