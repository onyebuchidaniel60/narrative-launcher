# Linux production unit. Not testable on Windows dev.
[Unit]
Description=Narrative Launcher bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=narrative
Group=narrative
WorkingDirectory=/opt/narrative-launcher
Environment=NODE_ENV=production
EnvironmentFile=/opt/narrative-launcher/.env
# Adjust this path if Node 22.23.4 is installed somewhere other than /usr/bin/node.
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/narrative-launcher/data

[Install]
WantedBy=multi-user.target
